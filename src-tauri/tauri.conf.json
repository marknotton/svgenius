{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVGenius",
  "mainBinaryName": "SVGenius",
  "version": "../package.json",
  "identifier": "studio.yello.svgenius",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SVGenius",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Bulk SVG optimiser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "svg"
        ],
        "name": "SVG",
        "description": "Scalable Vector Graphic",
        "role": "Viewer",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": [
          "svgenius"
        ],
        "name": "SVGenius Project",
        "description": "SVGenius project: files, settings and edits",
        "role": "Editor",
        "mimeType": "application/x-svgenius-project+json"
      }
    ]
  }
}
