{
  "name": "@marknotton/svgenius-ui",
  "version": "0.1.0",
  "description": "The SVGenius React screens (preset editor, markup editor and friends), for embedding in other apps through a host profile.",
  "keywords": [
    "svg",
    "svgo",
    "react",
    "editor"
  ],
  "license": "MIT",
  "author": "Mark Notton",
  "homepage": "https://github.com/marknotton/svgenius",
  "bugs": "https://github.com/marknotton/svgenius/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marknotton/svgenius.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./assets/*": "./src/assets/*",
    "./host": "./src/host.ts",
    "./icons": "./src/icons.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@marknotton/svgenius-core": "workspace:^",
    "monaco-editor": "^0.57.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
